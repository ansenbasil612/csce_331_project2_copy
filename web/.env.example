# Copy this file to .env and fill in the password. .env is git-ignored.
# The TAMU database needs TAMU Wi-Fi or the VPN.
PGHOST=csce-315-db.engr.tamu.edu
PGPORT=5432
PGDATABASE=squad_73_db
PGUSER=squad_73
PGPASSWORD=

# Port for the web server (http://localhost:3000)
PORT=3000

# Kiosk orders have no cashier, but orders.employee_id is required.
# Orders placed from the self-service kiosk are saved under this employee.
KIOSK_EMPLOYEE_ID=1
